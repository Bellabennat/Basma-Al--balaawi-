            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 30px 70px;
            max-width: 1000px;
            margin: auto;
        }

        .skill {
            margin-bottom: 15px;
        }

        .skill-info {
            display: flex;
            justify-content: space-between;
            font-weight: bold;
            margin-bottom: 8px;
        }

        .skill-bar {
