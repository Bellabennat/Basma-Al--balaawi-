            background: #041127;
            color: #d6deed;
            text-align: center;
            padding: 30px 20px;
        }

        footer .footer-name {
            color: var(--gold);
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 8px;
        }

        footer p {
            font-size: 14px;
        }

        /* MOBILE */
        @media (max-width: 1000px) {
            .services {
                grid-template-columns: repeat(2, 1fr);
            }

            .about,
            .contact {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 700px) {
            nav {
                padding: 15px 5%;
            }

            .logo {
                font-size: 20px;
            }

            .menu-btn {
                display: block;
            }

            nav ul {
                display: none;
                position: absolute;
                top: 65px;
                left: 0;
                width: 100%;
                background: #06142e;
                flex-direction: column;
                text-align: center;
                padding: 25px;
                gap: 20px;
            }

            nav ul.active {
                display: flex;
            }

            .hero {
                padding: 130px 7% 70px;
                min-height: auto;
            }

            .hero h1 {
                font-size: 45px;
            }

            .hero h2 {
                font-size: 22px;
            }

            section {
                padding: 65px 6%;
            }

            .section-title h2 {
                font-size: 32px;
            }

            .services,
            .skills {
                grid-template-columns: 1fr;
            }

            .about-box {
                grid-template-columns: 1fr 1fr;
            }

            .form-row {
                grid-template-columns: 1fr;
                gap: 0;
            }

            .contact-form {
                padding: 25px;
            }

            .cta {
                margin: 0 5% 60px;
            }

            .cta h2 {
                font-size: 30px;
            }
        }
    </style>
</head>

