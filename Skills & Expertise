            background: #e5e9f0;
            border-radius: 20px;
            overflow: hidden;
        }

        .skill-progress {
            height: 100%;
            background: var(--navy);
            border-radius: 20px;
        }

        /* CONTACT */
        .contact-section {
            background: #fafbfe;
        }

        .contact {
            display: grid;
            grid-template-columns: 0.8fr 1.2fr;
            gap: 60px;
        }

        .contact-info h2 {
            font-family: Georgia, serif;
            color: var(--navy);
            font-size: 40px;
            margin-bottom: 15px;
        }

        .contact-info p {
            color: var(--gray);
            margin-bottom: 25px;
        }

        .contact-item {
            display: flex;
            align-items: center;
            gap: 15px;
            margin: 18px 0;
        }

        .contact-item .contact-icon {
            width: 45px;
            height: 45px;
            border-radius: 50%;
            background: #edf3ff;
            display: flex;
            justify-content: center;
            align-items: center;
            color: var(--navy);
        }

        .contact-item a {
            color: var(--text);
            text-decoration: none;
        }

        .contact-item a:hover {
            color: var(--gold);
        }

        .contact-form {
            background: white;
            padding: 35px;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(10, 30, 60, 0.08);
        }

        .form-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

        .contact-form input,
        .contact-form textarea {
            width: 100%;
            padding: 15px;
            border: 1px solid #dce2eb;
            border-radius: 5px;
            margin-bottom: 15px;
            font-family: inherit;
            outline: none;
        }

        .contact-form input:focus,
        .contact-form textarea:focus {
            border-color: var(--gold);
        }

        .contact-form textarea {
            height: 150px;
            resize: vertical;
        }

        .submit-btn {
            border: none;
            cursor: pointer;
            width: 100%;
            font-size: 16px;
        }

        /* CTA */
        .cta {
            background: var(--navy);
            color: white;
            text-align: center;
            padding: 60px 20px;
            margin: 0 8% 80px;
            border-radius: 15px;
        }

        .cta h2 {
            font-family: Georgia, serif;
            font-size: 38px;
            margin-bottom: 10px;
        }

        .cta p {
            color: #d7deea;
            margin-bottom: 25px;
        }

        /* FOOTER */
