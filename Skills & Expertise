            height: 55px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 50%;
            background: #edf3ff;
            color: #0b55c9;
            font-size: 25px;
            margin-bottom: 20px;
        }

        .service-card h3 {
            color: var(--navy);
            margin-bottom: 12px;
            font-size: 18px;
        }

        .service-card p {
            color: var(--gray);
            font-size: 14px;
        }

        /* SKILLS */
