    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            scroll-behavior: smooth;
        }

        :root {
            --navy: #071936;
            --navy-light: #102b5c;
            --gold: #f5b72b;
            --gold-light: #ffd76a;
            --white: #ffffff;
            --light: #f5f8fc;
            --text: #17233c;
            --gray: #657083;
        }

        body {
            font-family: Arial, Helvetica, sans-serif;
            color: var(--text);
            background: var(--white);
            line-height: 1.6;
        }

        /* NAVIGATION */
        nav {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            z-index: 1000;
            background: rgba(5, 18, 42, 0.97);
            padding: 18px 6%;
            display: flex;
            justify-content: space-between;
            align-items: center;
        }

        .logo {
            color: var(--gold);
            font-size: 25px;
            font-weight: bold;
            font-family: Georgia, serif;
        }

        nav ul {
            list-style: none;
            display: flex;
            gap: 32px;
        }

        nav ul li a {
            color: white;
            text-decoration: none;
            font-weight: 600;
            transition: 0.3s;
        }

        nav ul li a:hover {
            color: var(--gold);
        }

        .menu-btn {
            display: none;
            color: white;
            font-size: 28px;
            cursor: pointer;
        }

        /* HERO */
        .hero {
            min-height: 100vh;
            padding: 150px 8% 90px;
            background:
                radial-gradient(circle at 80% 30%, rgba(245,183,43,0.12), transparent 25%),
                linear-gradient(135deg, #06142e, #102e63);
            color: white;
            display: flex;
            align-items: center;
            position: relative;
            overflow: hidden;
        }

        .hero::after {
            content: "";
            position: absolute;
            width: 700px;
            height: 700px;
            right: -350px;
            bottom: -350px;
            border: 1px solid rgba(255,255,255,0.08);
            border-radius: 50%;
            box-shadow:
                0 0 0 80px rgba(255,255,255,0.02),
                0 0 0 160px rgba(255,255,255,0.02);
        }

        .hero-content {
            max-width: 760px;
            position: relative;
            z-index: 2;
        }

        .small-title {
            color: var(--gold);
            font-size: 20px;
            font-weight: bold;
            margin-bottom: 12px;
        }

        .hero h1 {
            font-family: Georgia, serif;
            font-size: clamp(45px, 7vw, 78px);
            line-height: 1.05;
            margin-bottom: 15px;
        }

        .hero h2 {
            color: var(--gold);
            font-size: 28px;
            margin-bottom: 22px;
        }

        .hero p {
            max-width: 650px;
            font-size: 18px;
            color: #e6ebf4;
            margin-bottom: 32px;
        }

        .buttons {
            display: flex;
            gap: 15px;
            flex-wrap: wrap;
        }

        .btn {
            display: inline-block;
            padding: 14px 28px;
            border-radius: 6px;
            text-decoration: none;
            font-weight: bold;
            transition: 0.3s;
        }

        .btn-primary {
            background: var(--gold);
            color: #111;
        }

        .btn-primary:hover {
            background: var(--gold-light);
            transform: translateY(-3px);
        }

        .btn-outline {
            border: 1px solid white;
            color: white;
        }

        .btn-outline:hover {
            background: white;
            color: var(--navy);
        }

        /* GENERAL */
        section {
            padding: 90px 8%;
        }

        .section-title {
            text-align: center;
            margin-bottom: 50px;
        }

        .section-title span {
            color: var(--gold);
            font-weight: bold;
            text-transform: uppercase;
            font-size: 14px;
        }

        .section-title h2 {
            font-family: Georgia, serif;
            font-size: 42px;
            margin-top: 8px;
            color: var(--navy);
        }

        .section-title p {
            color: var(--gray);
            max-width: 650px;
            margin: 10px auto;
        }

        /* ABOUT */
        .about {
            display: grid;
            grid-template-columns: 1.1fr 0.9fr;
            gap: 60px;
            align-items: center;
        }

        .about-text h2 {
            font-family: Georgia, serif;
            font-size: 40px;
            color: var(--navy);
            margin-bottom: 20px;
        }

        .about-text h2::after {
            content: "";
            display: block;
            width: 50px;
            height: 3px;
            background: var(--gold);
            margin-top: 10px;
        }

        .about-text p {
            color: #4f5c70;
            margin-bottom: 17px;
            font-size: 17px;
        }

        .about-box {
            display: grid;
            grid-template-columns: 1fr 1fr;
            box-shadow: 0 15px 40px rgba(8, 29, 60, 0.10);
            border-radius: 12px;
            overflow: hidden;
        }

        .about-card {
            padding: 35px 20px;
            text-align: center;
            background: white;
            border: 1px solid #edf0f5;
        }

        .about-card .icon {
            font-size: 30px;
            color: var(--gold);
            margin-bottom: 10px;
        }

        .about-card h3 {
            color: var(--navy);
            font-family: Georgia, serif;
        }

        .about-card p {
            color: var(--gray);
            font-size: 14px;
        }

        /* SERVICES */
        .services-section {
            background: var(--light);
        }

        .services {
            display: grid;
            grid-template-columns: repeat(5, 1fr);
            gap: 18px;
        }

        .service-card {
            background: white;
            padding: 30px 20px;
            border-radius: 10px;
            box-shadow: 0 8px 25px rgba(10, 30, 60, 0.06);
            transition: 0.3s;
            border: 1px solid #e9eef5;
        }

        .service-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 15px 35px rgba(10, 30, 60, 0.12);
        }

        .service-icon {
